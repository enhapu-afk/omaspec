# Maintainer: Nils Hoffmann
#
# Installs the Omagram binary built by the release workflow
# (.github/workflows/release.yml). Before submitting: set `url`, `pkgver`
# and the checksum (`updpkgsums`); see packaging/RELEASING.md.

pkgname=omagram-bin
_pkgname=omagram
pkgver=0.4.0
pkgrel=1
pkgdesc="Native PlantUML and Mermaid editor and live preview for Omarchy (prebuilt)"
arch=('x86_64')
url="https://github.com/OWNER/omagram"
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'libxkbcommon' 'wayland' 'vulkan-icd-loader')
optdepends=(
  'plantuml: optional, Java; draws the few PlantUML types the native engine does not (JSON, YAML, Salt, ...)'
  'wl-clipboard: copy diagrams to the clipboard'
  'git: compare a diagram with a git commit'
  'libnotify: notifications outside Omarchy'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source_x86_64=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums_x86_64=('SKIP')

package() {
  cd "$_pkgname-$pkgver-x86_64-linux"
  install -Dm755 omagram "$pkgdir/usr/bin/omagram"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 omagram.desktop "$pkgdir/usr/share/applications/omagram.desktop"
  install -Dm644 omagram.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omagram.svg"
  install -Dm644 omagram-mime.xml "$pkgdir/usr/share/mime/packages/omagram.xml"
  install -Dm644 -t "$pkgdir/usr/share/omagram/omarchy" omarchy/*
}
