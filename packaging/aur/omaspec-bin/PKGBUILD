# Maintainer: Nils Hoffmann
#
# Installs the Omaspec binary built by the release workflow
# (.github/workflows/release.yml). Before submitting: set `pkgver`
# and the checksum (`updpkgsums`); see packaging/RELEASING.md.

pkgname=omaspec-bin
_pkgname=omaspec
pkgver=0.4.2
pkgrel=1
pkgdesc="Native PlantUML and Mermaid editor and live preview for Omarchy (prebuilt)"
arch=('x86_64')
url="https://github.com/enhapu-afk/omaspec"
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'libxkbcommon' 'wayland' 'vulkan-icd-loader')
optdepends=(
  'plantuml: optional, Java; draws the few PlantUML types the native engine does not (YAML, Salt, ...)'
  'wl-clipboard: copy diagrams to the clipboard'
  'git: compare a diagram with a git commit'
  'libnotify: notifications outside Omarchy'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source_x86_64=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums_x86_64=('b755f65192cb78e938ab84b5a5c281d51ca66e5d3ba8cfc30e15f046e3dc960c')

package() {
  cd "$_pkgname-$pkgver-x86_64-linux"
  install -Dm755 omaspec "$pkgdir/usr/bin/omaspec"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 omaspec.desktop "$pkgdir/usr/share/applications/omaspec.desktop"
  install -Dm644 omaspec.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaspec.svg"
  install -Dm644 omaspec-mime.xml "$pkgdir/usr/share/mime/packages/omaspec.xml"
  install -Dm644 -t "$pkgdir/usr/share/omaspec/omarchy" omarchy/*
}
