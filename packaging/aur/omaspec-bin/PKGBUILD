# Maintainer: Nils Hoffmann
#
# Installs the Omaspec binary built by the release workflow
# (.github/workflows/release.yml). Before submitting: set `pkgver`
# and the checksum (`updpkgsums`); see packaging/RELEASING.md.

pkgname=omaspec-bin
_pkgname=omaspec
pkgver=0.9.6
pkgrel=1
pkgdesc="Native PlantUML and Mermaid editor and live preview for Omarchy (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/enhapu-afk/omaspec"
license=('MIT' 'OFL-1.1-no-RFN')
depends=('glibc' 'fontconfig' 'libxkbcommon' 'wayland' 'vulkan-icd-loader')
optdepends=(
  'plantuml: optional, Java; draws the few PlantUML types the native engine does not (Graphviz, tree diagrams)'
  'wl-clipboard: copy diagrams to the clipboard'
  'git: compare a diagram with a git commit'
  'libnotify: notifications outside Omarchy'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!debug')
source_x86_64=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums_x86_64=('08a0dc9cbb97acb4d8f3d1f2dd1cf0e439726a341e05d01a53f5450743d79e19')
sha256sums_aarch64=('4933b4cd4c5ed71ddd6e32dd4c04b1b787a1d2d76f9af3394e9245295396d80e')
source_aarch64=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-aarch64-linux.tar.gz")

package() {
  cd "$_pkgname-$pkgver-$CARCH-linux"
  install -Dm755 omaspec "$pkgdir/usr/bin/omaspec"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The handwriting face of a sketch, built into the binary.
  install -Dm644 OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 omaspec.desktop "$pkgdir/usr/share/applications/omaspec.desktop"
  install -Dm644 omaspec.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaspec.svg"
  install -Dm644 omaspec-mime.xml "$pkgdir/usr/share/mime/packages/omaspec.xml"
  install -Dm644 -t "$pkgdir/usr/share/omaspec/omarchy" omarchy/*
}
