pkgbase = omaspec-bin
	pkgdesc = Native PlantUML and Mermaid editor and live preview for Omarchy (prebuilt)
	pkgver = 1.3.0
	pkgrel = 1
	url = https://github.com/enhapu-afk/omaspec
	arch = x86_64
	arch = aarch64
	license = MIT
	license = OFL-1.1-no-RFN
	depends = glibc
	depends = fontconfig
	depends = libxkbcommon
	depends = wayland
	depends = vulkan-icd-loader
