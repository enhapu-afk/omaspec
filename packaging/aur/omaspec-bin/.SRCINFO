pkgbase = omaspec-bin
	pkgdesc = Native PlantUML and Mermaid editor and live preview for Omarchy (prebuilt)
	pkgver = 1.2.0
	pkgrel = 1
	url = https://github.com/enhapu-afk/omaspec
	arch = x86_64
	arch = aarch64
	license = MIT
	license = OFL-1.1-no-RFN
	depends = glibc
	depends = fontconfig
	depends = libxkbcommon
	depends = wayland
	depends = vulkan-icd-loader
	optdepends = plantuml: optional, Java; draws the few PlantUML types the native engine does not (Graphviz, tree diagrams)
	optdepends = wl-clipboard: copy diagrams to the clipboard
	optdepends = git: compare a diagram with a git commit
	optdepends = libnotify: notifications outside Omarchy
	optdepends = noto-fonts-emoji: emoji in diagrams, where no emoji font is installed
	provides = omaspec
	conflicts = omaspec
	options = !debug
