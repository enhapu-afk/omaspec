' A motion controller: ten functions and one hundred signals.
' Sampler stands beside three subsystems. Every signal runs forward
' to the next block.
'
'   28 wires on the plant edge and between the subsystems
'   24 wires inside Condition
'   30 wires inside Motion
'   18 wires inside Observe
@startflow
title Motion plant
caption Ten functions, one hundred signals
left to right direction

in v_bus
in i_bus
in temp
in run

out fault
out energy
out log
out alarm
out speed
out temp_o

block Sampler "Sampler" {
  in v_bus
  in i_bus
  in temp
  in run
  out v_s
  out i_s
  out t_s
  out v_n
  out i_n
  out ready
}

block Condition "Condition" {

  ' Filter, then scale, then the observer.
  in v_s
  in i_s
  in t_s
  in v_n
  in i_n
  in ready
  out v_hat
  out i_hat
  out t_hat
  out w_hat
  out flux
  out armed

  block Filter "Filter" {
    in v_s
    in i_s
    in t_s
    in v_n
    in i_n
    in ready
    out v_f
    out i_f
    out t_f
    out vn_f
    out in_f
    out rd_f
  }

  block Scale "Scale" {
    in v_f
    in i_f
    in t_f
    in vn_f
    in in_f
    in rd_f
    out v_u
    out i_u
    out t_u
    out w_u
    out fl_u
    out rd_u
  }

  block Estimate "Estimate" {
    in v_u
    in i_u
    in t_u
    in w_u
    in fl_u
    in rd_u
    out v_hat
    out i_hat
    out t_hat
    out w_hat
    out flux
    out armed
  }

  v_s -> Filter.v_s
  i_s -> Filter.i_s
  t_s -> Filter.t_s
  v_n -> Filter.v_n
  i_n -> Filter.i_n
  ready -> Filter.ready
  Filter.v_f -> Scale.v_f
  Filter.i_f -> Scale.i_f
  Filter.t_f -> Scale.t_f
  Filter.vn_f -> Scale.vn_f
  Filter.in_f -> Scale.in_f
  Filter.rd_f -> Scale.rd_f
  Scale.v_u -> Estimate.v_u
  Scale.i_u -> Estimate.i_u
  Scale.t_u -> Estimate.t_u
  Scale.w_u -> Estimate.w_u
  Scale.fl_u -> Estimate.fl_u
  Scale.rd_u -> Estimate.rd_u
  Estimate.v_hat -> v_hat
  Estimate.i_hat -> i_hat
  Estimate.t_hat -> t_hat
  Estimate.w_hat -> w_hat
  Estimate.flux -> flux
  Estimate.armed -> armed
}

block Motion "Motion" {

  ' Guard, current control, modulator, inverter.
  in v_hat
  in i_hat
  in t_hat
  in w_hat
  in flux
  in armed
  out torque
  out flux_o
  out duty_a
  out duty_b
  out duty_c
  out gate

  block Guard "Guard" {
    in v_hat
    in i_hat
    in t_hat
    in w_hat
    in flux
    in armed
    out v_g
    out i_g
    out t_g
    out w_g
    out fl_g
    out rd_g
  }

  block Control "Control" {
    in v_g
    in i_g
    in t_g
    in w_g
    in fl_g
    in rd_g
    out trq
    out flux_c
    out id
    out iq
    out lim
    out mode
  }

  block Mix "Mix" {
    in trq
    in flux_c
    in id
    in iq
    in lim
    in mode
    out da
    out db
    out dc
    out ena
    out brk
    out mode_m
  }

  block Drive "Drive" {
    in da
    in db
    in dc
    in ena
    in brk
    in mode_m
    out torque
    out flux_o
    out duty_a
    out duty_b
    out duty_c
    out gate
  }

  v_hat -> Guard.v_hat
  i_hat -> Guard.i_hat
  t_hat -> Guard.t_hat
  w_hat -> Guard.w_hat
  flux -> Guard.flux
  armed -> Guard.armed
  Guard.v_g -> Control.v_g
  Guard.i_g -> Control.i_g
  Guard.t_g -> Control.t_g
  Guard.w_g -> Control.w_g
  Guard.fl_g -> Control.fl_g
  Guard.rd_g -> Control.rd_g
  Control.trq -> Mix.trq
  Control.flux_c -> Mix.flux_c
  Control.id -> Mix.id
  Control.iq -> Mix.iq
  Control.lim -> Mix.lim
  Control.mode -> Mix.mode
  Mix.da -> Drive.da
  Mix.db -> Drive.db
  Mix.dc -> Drive.dc
  Mix.ena -> Drive.ena
  Mix.brk -> Drive.brk
  Mix.mode_m -> Drive.mode_m
  Drive.torque -> torque
  Drive.flux_o -> flux_o
  Drive.duty_a -> duty_a
  Drive.duty_b -> duty_b
  Drive.duty_c -> duty_c
  Drive.gate -> gate
}

block Observe "Observe" {

  ' Watch the drive, then keep the record.
  in torque
  in flux_o
  in duty_a
  in duty_b
  in duty_c
  in gate
  out fault
  out energy
  out log
  out alarm
  out speed
  out temp_o

  block Monitor "Monitor" {
    in torque
    in flux_o
    in duty_a
    in duty_b
    in duty_c
    in gate
    out trq_m
    out flux_m
    out temp_m
    out load
    out health
    out trip
  }

  block Record "Record" {
    in trq_m
    in flux_m
    in temp_m
    in load
    in health
    in trip
    out fault
    out energy
    out log
    out alarm
    out speed
    out temp_o
  }

  torque -> Monitor.torque
  flux_o -> Monitor.flux_o
  duty_a -> Monitor.duty_a
  duty_b -> Monitor.duty_b
  duty_c -> Monitor.duty_c
  gate -> Monitor.gate
  Monitor.trq_m -> Record.trq_m
  Monitor.flux_m -> Record.flux_m
  Monitor.temp_m -> Record.temp_m
  Monitor.load -> Record.load
  Monitor.health -> Record.health
  Monitor.trip -> Record.trip
  Record.fault -> fault
  Record.energy -> energy
  Record.log -> log
  Record.alarm -> alarm
  Record.speed -> speed
  Record.temp_o -> temp_o
}

v_bus -> Sampler.v_bus
i_bus -> Sampler.i_bus
temp -> Sampler.temp
run -> Sampler.run
Sampler.v_s -> Condition.v_s
Sampler.i_s -> Condition.i_s
Sampler.t_s -> Condition.t_s
Sampler.v_n -> Condition.v_n
Sampler.i_n -> Condition.i_n
Sampler.ready -> Condition.ready
Condition.v_hat -> Motion.v_hat
Condition.i_hat -> Motion.i_hat
Condition.t_hat -> Motion.t_hat
Condition.w_hat -> Motion.w_hat
Condition.flux -> Motion.flux
Condition.armed -> Motion.armed
Motion.torque -> Observe.torque
Motion.flux_o -> Observe.flux_o
Motion.duty_a -> Observe.duty_a
Motion.duty_b -> Observe.duty_b
Motion.duty_c -> Observe.duty_c
Motion.gate -> Observe.gate
Observe.fault -> fault
Observe.energy -> energy
Observe.log -> log
Observe.alarm -> alarm
Observe.speed -> speed
Observe.temp_o -> temp_o
@endflow
