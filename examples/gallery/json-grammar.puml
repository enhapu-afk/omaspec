@startebnf
(* JSON in EBNF: each rule a track, a name it uses in a gray box, a word
   as written in a white one. *)
title JSON, rule by rule
value = object | array | string | number | "true" | "false" | "null" ;
object = "{", [ member, { ",", member } ], "}" ;
member = string, ":", value ;
array = "[", [ value, { ",", value } ], "]" ;
number = [ "-" ], digits, [ ".", digits ] ;
digits = ? a digit 0 to 9 ?, { ? a digit 0 to 9 ? } ;
@endebnf
