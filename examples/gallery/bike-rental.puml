@startuml
' C4-PlantUML: Omaspec knows the library's macros by name and reads
' nothing from the network. A sprite of Open Iconic (`&cog`) stands
' above an element's name, drawn in its ink.
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Bike rental: containers

Person(rider, "Rider", "Rents a bike with the app")
Person(mechanic, "Mechanic", "Keeps the bikes on the road")

System_Boundary(rental, "Bike rental") {
  Container(app, "Rider app", "Kotlin, Swift", "Finds a bike, unlocks it, pays", $sprite="&phone")
  Container(api, "Rental API", "Rust, axum", "Rentals, prices, bikes", $sprite="&cog")
  ContainerDb(db, "Rentals", "PostgreSQL", "Riders, rentals, invoices")
  ContainerQueue(events, "Bike events", "NATS", "Where each bike is, its lock")
  Container(workshop, "Workshop", "Web app", "Repairs and spare parts", $sprite="&wrench")
}

System_Ext(payments, "Payment provider", "Cards and wallets", $sprite="&credit-card")
System_Ext(locks, "Smart locks", "A lock on every bike", $sprite="&lock-locked")

Rel(rider, app, "Uses")
Rel(app, api, "Calls", "JSON/HTTPS")
Rel_R(api, db, "Reads and writes", "SQL")
Rel(api, events, "Listens to")
Rel(locks, events, "Reports", "MQTT")
Rel_R(api, payments, "Charges", "HTTPS")
Rel(mechanic, workshop, "Uses")
Rel_Back(workshop, events, "Low battery, flat tyre")
@enduml
