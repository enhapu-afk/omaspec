/target/
# Spike output
/spikes/*/out/

# Built only when testing a vendored crate on its own.
vendor/*/target/
vendor/*/Cargo.lock

# cargo-fuzz output.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/Cargo.lock

# makepkg output when a package in packaging/aur is built in place.
/packaging/aur/*/src/
/packaging/aur/*/pkg/
/packaging/aur/*/*.tar.*
/packaging/aur/*/*.log
/packaging/aur/omaspec-git/omaspec/
