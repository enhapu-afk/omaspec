%YAML 1.2
---
# Mermaid highlighting for Omaspec. Lines are matched without their
# newline (syntect "no newlines" mode), so `$` is the end of the line.
# Scopes follow plantuml.sublime-syntax, so both take the same colors.
name: Mermaid
file_extensions: [mmd, mermaid]
scope: source.mermaid

variables:
  head: '(?:flowchart|graph|sequenceDiagram|classDiagram(?:-v2)?|stateDiagram(?:-v2)?|erDiagram|journey|gantt|pie|gitGraph|mindmap|timeline|quadrantChart|requirementDiagram|C4Context|C4Container|C4Component|C4Dynamic|C4Deployment|sankey-beta|xychart-beta|block-beta|packet-beta|kanban|architecture-beta|zenuml|radar-beta|treemap-beta)'
  # Entity relations: ||--o{, }|..|{, |o--o| …
  er_arrow: '(?:\|o|\|\||\}o|\}\|)(?:--|\.\.)(?:o\||\|\||o\{|\|\{)'
  # Links and arrows of flowcharts, classes and states: -->, ---, -.->,
  # ==>, ~~~, <|--, *--, o--, ..|>, --o, --x, <-->, and longer ones.
  link: '(?:<\||<|\*)?(?:-{2,}|-\.+-|\.{2,}|={2,}|~{3,})(?:\|>|>|\*|[xo](?!\w))?'
  # Sequence messages: ->>, -->>, ->, -->, -x, --x, -), --), <<->>.
  message: '<<-{1,2}>>|-{1,2}>>|-{1,2}>|-{1,2}[x)](?!\w)'
  # Node text in its shape: A[…], B(…), C{…}, D((…)), E[(…)], F{{…}} …
  shape_open: '\[\[|\[\(|\(\(|\(\[|\{\{|\[/|\[\\|\[|\(|\{|>'
  shape_close: '\]\]|\)\]|\)\)|\]\)|\}\}|/\]|\\\]|\]|\)|\}'

contexts:
  main:
    - match: '^\s*(%%\{)(.*?)(\}%%)\s*$'
      captures:
        1: keyword.control.directive.mermaid
        2: meta.directive.mermaid
        3: keyword.control.directive.mermaid
    - match: '^\s*%%.*$'
      scope: comment.line.percentage.mermaid
    - match: '^\s*(---)\s*$'
      captures:
        1: keyword.control.directive.mermaid
      push: front_matter
    - match: '^\s*({{head}})\b(.*)$'
      captures:
        1: keyword.control.directive.mermaid
        2: entity.name.diagram.mermaid
    - match: '^\s*(title|section|accTitle|accDescr)\b\s*:?(.*)$'
      captures:
        1: keyword.other.mermaid
        2: entity.name.section.mermaid
    # A note: `note right of A : text` on one line, or a block up to `end note`.
    - match: '^\s*((?i:note))\b([^:]*)(:)(.*)$'
      captures:
        1: keyword.other.mermaid
        3: punctuation.separator.message.mermaid
        4: string.unquoted.message.mermaid
    - match: '^\s*((?i:note))\b(.*)$'
      captures:
        1: keyword.other.mermaid
      push: note_body
    - include: line

  line:
    # Styling lines hold `fill:#f9f,stroke:#333`; their colons are no messages.
    - match: '^\s*(classDef|style|linkStyle|class|click)\b'
      captures:
        1: keyword.other.mermaid
      push: styling
    - match: '"'
      scope: punctuation.definition.string.begin.mermaid
      push: string
    - match: '(?<![\w-])({{er_arrow}})|({{message}}|{{link}})(?:\s*(\|)([^|]*)(\|))?'
      captures:
        1: keyword.operator.arrow.mermaid
        2: keyword.operator.arrow.mermaid
        3: punctuation.definition.label.mermaid
        4: string.unquoted.message.mermaid
        5: punctuation.definition.label.mermaid
    - match: ':::[\w-]+'
      scope: storage.modifier.class.mermaid
    - match: '(?<!:)(:)(?!:)(.*)$'
      captures:
        1: punctuation.separator.message.mermaid
        2: string.unquoted.message.mermaid
    - match: '(?<=\w)({{shape_open}})([^\]\)\}"]*)({{shape_close}})'
      captures:
        1: punctuation.definition.shape.mermaid
        2: string.unquoted.activity.mermaid
        3: punctuation.definition.shape.mermaid
    - include: inline

  styling:
    - match: '$'
      pop: true
    - include: inline

  inline:
    - match: '<<[^>]*>>'
      scope: storage.modifier.stereotype.mermaid
    - match: ':::[\w-]+'
      scope: storage.modifier.class.mermaid
    - match: '\[\*\]'
      scope: keyword.other.mermaid
    - match: '#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3,4})\b'
      scope: constant.other.color.mermaid
    - match: '\b\d+(?:\.\d+)?(?:px|%|[dhmsw])?\b'
      scope: constant.numeric.mermaid
    - match: '\b(?:subgraph|end|direction|TB|TD|BT|RL|LR|participant|actor|as|loop|alt|else|opt|par|and|critical|break|rect|over|left of|right of|activate|deactivate|autonumber|box|create|destroy|link|links|state|fork|join|choice|class|classDef|style|linkStyle|click|call|href|namespace|dateFormat|axisFormat|tickInterval|todayMarker|excludes|includes|weekday|commit|branch|checkout|merge|cherry-pick|showData|root)\b'
      scope: keyword.other.mermaid

  string:
    - meta_scope: string.quoted.double.mermaid
    - match: '"'
      scope: punctuation.definition.string.end.mermaid
      pop: true
    - match: '$'
      pop: true

  note_body:
    - meta_content_scope: markup.quote.note.mermaid
    - match: '^\s*((?i:end\s+note))\b'
      captures:
        1: keyword.other.mermaid
      pop: true

  front_matter:
    - meta_content_scope: meta.front-matter.mermaid
    - match: '^\s*(---)\s*$'
      captures:
        1: keyword.control.directive.mermaid
      pop: true
    - match: '^\s*([\w-]+)(:)'
      captures:
        1: variable.other.key.mermaid
        2: punctuation.separator.key-value.mermaid
