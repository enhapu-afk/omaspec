%YAML 1.2
---
# PlantUML highlighting for Omagram. Lines are matched without their
# newline (syntect "no newlines" mode), so `$` is the end of the line.
name: PlantUML
file_extensions: [puml, plantuml, pu, iuml, wsd]
scope: source.plantuml

variables:
  arrow_right: '[-.=]+(?:\[[^\]]*\])?(?:(?:up|down|left|right|u|d|l|r)[-.=]+)?[-.=]*\|?>{1,2}[xo]?'
  arrow_left: '[xo]?<{1,2}\|?[-.=]+(?:\[[^\]]*\])?[-.=]*>?'
  link: '[*o#+]?(?:-{2,}|\.{2,})[*o#+]?'

contexts:
  main:
    - include: comments
    - match: '^\s*(@(?:start|end)\w*)\b(.*)$'
      captures:
        1: keyword.control.directive.plantuml
        2: entity.name.diagram.plantuml
    - match: '^\s*(!\w+)'
      captures:
        1: keyword.other.preprocessor.plantuml
    - match: '^\s*(==)(.*?)(==)\s*$'
      captures:
        1: punctuation.definition.section.plantuml
        2: entity.name.section.plantuml
        3: punctuation.definition.section.plantuml
    - match: '^\s*(\|)([^|]+)(\|)'
      captures:
        1: punctuation.definition.swimlane.plantuml
        2: entity.name.section.swimlane.plantuml
        3: punctuation.definition.swimlane.plantuml
    # Multi-line note: `note left`, `note over A, B`, `hnote over X` without `:`.
    - match: '^\s*((?i:[hr]?note))\b(?![^:]*:)(.*)$'
      captures:
        1: keyword.other.note.plantuml
        2: meta.note.position.plantuml
      push: note_body
    - match: '^\s*((?i:legend))\b(.*)$'
      captures:
        1: keyword.other.plantuml
      push: legend_body
    # Activity: `:Do something;` on one line.
    - match: '^\s*(:)(.*?)([;|<>\]}/])\s*$'
      captures:
        1: punctuation.definition.activity.plantuml
        2: string.unquoted.activity.plantuml
        3: punctuation.definition.activity.plantuml
    - match: '(?<![\w>-])(?:{{arrow_left}}|{{arrow_right}}|{{link}})(?![\w<-])'
      scope: keyword.operator.arrow.plantuml
      push: after_arrow
    - include: inline

  inline:
    - match: '"'
      scope: punctuation.definition.string.begin.plantuml
      push: string
    - match: '<<[^>]*>>'
      scope: storage.modifier.stereotype.plantuml
    - match: '#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3}|[A-Za-z]+)\b'
      scope: constant.other.color.plantuml
    - match: '[$%]\w+'
      scope: variable.other.plantuml
    - match: '\b\d+(?:\.\d+)?\b'
      scope: constant.numeric.plantuml
    # Keywords are lowercase by convention; `State` or `End` are names.
    - match: '\b(?:participant|actor|boundary|control|entity|database|collections|queue|as|order|alt|else|opt|loop|par|break|critical|group|end|ref|over|of|activate|deactivate|destroy|create|return|autonumber|autoactivate|newpage|title|header|footer|caption|box|hide|show|skinparam|skin|scale|direction|together|left|right|top|bottom|up|down|start|stop|kill|detach|if|then|elseif|endif|while|endwhile|repeat|backward|fork|again|split|merge|partition|switch|case|endswitch|class|interface|enum|abstract|annotation|package|namespace|extends|implements|component|node|cloud|folder|frame|storage|artifact|card|file|agent|stack|rectangle|usecase|state|object|map|json|yaml|note|hnote|rnote|style|endstyle)\b'
      scope: keyword.other.plantuml

  # After an arrow: the optional `: message` up to the end of the line.
  after_arrow:
    - match: '(:)(.*)$'
      captures:
        1: punctuation.separator.message.plantuml
        2: string.unquoted.message.plantuml
      pop: true
    - match: '$'
      pop: true
    - include: inline

  string:
    - meta_scope: string.quoted.double.plantuml
    - match: '"'
      scope: punctuation.definition.string.end.plantuml
      pop: true
    - match: '$'
      pop: true

  note_body:
    - meta_content_scope: markup.quote.note.plantuml
    - match: '^\s*((?i:end\s*[hr]?note))\b'
      captures:
        1: keyword.other.note.plantuml
      pop: true

  legend_body:
    - meta_content_scope: markup.quote.legend.plantuml
    - match: '^\s*((?i:end\s*legend))\b'
      captures:
        1: keyword.other.plantuml
      pop: true

  comments:
    - match: "^\\s*'.*$"
      scope: comment.line.quote.plantuml
    - match: "/'"
      scope: punctuation.definition.comment.begin.plantuml
      push: block_comment

  block_comment:
    - meta_scope: comment.block.plantuml
    - match: "'/"
      scope: punctuation.definition.comment.end.plantuml
      pop: true
