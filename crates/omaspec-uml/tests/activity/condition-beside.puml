@startuml
' `skinparam conditionStyle diamond`: each test beside an empty diamond,
' above it for an `if` and a `while`, right of it for a `repeat` (whose
' ways out then have no words); a `switch` and a row of `elseif`s keep
' their hexagons, as PlantUML draws them.
skinparam conditionStyle diamond
start
-> in;
if (Is it ready?) then (yes)
  :Go;
else (no)
  :Wait;
endif
while (More to do?) is (yes)
  :Work;
endwhile (no)
repeat
  :Try;
  backward :Again;
repeat while (Failed?) is (yes) not (no)
switch (Which one?)
case (a)
  :A;
case (b)
  :B;
endswitch
if (a?) then (yes)
  :A;
elseif (b?) then (yes)
  :B;
endif
stop
@enduml
